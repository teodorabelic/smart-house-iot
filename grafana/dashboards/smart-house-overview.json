{
  "id": null,
  "uid": "smart-house-overview",
  "title": "Smart House Overview",
  "tags": ["iot", "smart-house"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "pi_id",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influx-iot"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"iot_bucket\", tag: \"pi_id\", predicate: (r) => r._measurement == \"sensor_readings\")",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      },
      {
        "name": "code",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influx-iot"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"iot_bucket\", tag: \"code\", predicate: (r) => r._measurement == \"sensor_readings\")",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Numeric sensors by PI/component",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-iot"
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "query": "from(bucket: \"iot_bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sensor_readings\")\n  |> filter(fn: (r) => r._field == \"value_num\")\n  |> filter(fn: (r) => r.pi_id =~ /${pi_id:regex}/)\n  |> filter(fn: (r) => r.code =~ /${code:regex}/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Latest sensor events",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-iot"
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "targets": [
        {
          "query": "from(bucket: \"iot_bucket\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"sensor_readings\")\n  |> filter(fn: (r) => r.pi_id =~ /${pi_id:regex}/)\n  |> filter(fn: (r) => r.code =~ /${code:regex}/)\n  |> last()\n  |> sort(columns: [\"_time\"], desc: true)",
          "refId": "A"
        }
      ]
    }
  ]
}
