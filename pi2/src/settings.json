{
  "device": { "id": "PI2", "name": "kitchen" },
  "mqtt": { "host": "127.0.0.1", "port": 1883, "base_topic": "smarthome", "qos": 1 },
  "batch": { "max_batch_size": 50, "flush_interval_sec": 10.0 },
  "components": {
    "DS2": { "pin": 17, "simulated": true, "interval": 0.2 },
    "DUS2": { "trigger_pin": 23, "echo_pin": 24, "simulated": true, "interval": 1 },
    "DPIR2": { "pin": 25, "simulated": true, "interval": 1 },
    "4SD": { "clk_pin": 5, "dio_pin": 6, "simulated": true, "button_add_seconds": 30 },
    "BTN": { "pin": 13, "simulated": true, "interval": 0.2 },
    "DHT3": { "pin": 4, "simulated": true, "read_interval": 5 },
    "GSG": { "i2c_address": "0x68", "simulated": true, "threshold": 10.0, "interval": 1 }
  }
}